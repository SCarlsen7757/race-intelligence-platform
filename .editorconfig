# Race Intelligence Platform — shared code style.
#
# These rules are IDE/analyzer suggestions only: Directory.Build.props sets
# EnforceCodeStyleInBuild=false, so nothing here fails the build today. Note that if you ever
# flip that to true, TreatWarningsAsErrors=true means every `warning` severity below becomes a
# build error — raise severities deliberately, not by accident.
#
# Because of that, a rule here is worth nothing unless it describes the code as written. Rules that
# the whole repo ignores just train people to ignore the file. Every setting below was checked
# against the existing source; where the codebase is genuinely split, the rule is `silent` rather
# than picking a side that half the files violate.

root = true

[*]
charset = utf-8
end_of_line = crlf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{json,yml,yaml}]
indent_size = 2

[*.{csproj,props,targets,slnx,xml}]
indent_size = 2

# The dashboard. The .NET side of this repo indents by four; the JavaScript ecosystem indents by
# two, and so does every tool that formats it. Prettier reads this file, so without this section
# it would reformat the whole dashboard to four spaces on the first `npm run format` and then
# disagree with every other TypeScript project anyone has ever opened.
#
# LF rather than the CRLF above for the same reason the shell scripts are: these files are read by
# Node, and the dashboard is the one part of this repo expected to build on a Linux CI runner and
# in a container as readily as on Windows.
[src/RaceIntelligence.Dashboard/**.{ts,tsx,js,mjs,css,html}]
indent_size = 2
end_of_line = lf

[*.md]
# Two trailing spaces are a hard line break in Markdown.
trim_trailing_whitespace = false

[*.cs]
indent_size = 4

#### Usings ####

# System.* first, then everything else alphabetically.
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
csharp_using_directive_placement = outside_namespace:warning

#### Language conventions ####

# File-scoped namespaces — matches every existing file in the repo.
csharp_style_namespace_declarations = file_scoped:warning

# Genuinely split: the mapping and analysis code spells out int/double/string, while test setup
# and `for` loops use var. Both read fine, so this one has no opinion instead of flagging half
# the repo.
csharp_style_var_for_built_in_types = true:silent
# var everywhere else does match the code — roughly 450 uses across src and tests.
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion

csharp_prefer_braces = true:suggestion
# Every DI-constructed service, repository and fixture-backed test class in the repo uses one.
csharp_style_prefer_primary_constructors = true:suggestion
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = true:suggestion
csharp_style_expression_bodied_accessors = true:suggestion

csharp_style_pattern_matching_over_is_with_cast_check = true:suggestion
csharp_style_pattern_matching_over_as_with_null_check = true:suggestion
csharp_style_prefer_switch_expression = true:suggestion
csharp_style_prefer_null_check_over_type_check = true:suggestion
csharp_style_throw_expression = true:suggestion

dotnet_style_object_initializer = true:suggestion
dotnet_style_collection_initializer = true:suggestion
dotnet_style_prefer_conditional_expression_over_assignment = true:suggestion
dotnet_style_null_propagation = true:suggestion
dotnet_style_coalesce_expression = true:suggestion
dotnet_style_readonly_field = true:warning

# Telemetry mapping and interop code does a lot of numeric work; explicit precedence
# parentheses are worth keeping.
dotnet_style_parentheses_in_arithmetic_binary_operators = always_for_clarity:suggestion
dotnet_style_parentheses_in_relational_binary_operators = always_for_clarity:suggestion

#### this. qualification ####

dotnet_style_qualification_for_field = false:warning
dotnet_style_qualification_for_property = false:warning
dotnet_style_qualification_for_method = false:warning
dotnet_style_qualification_for_event = false:warning

#### Modifiers ####

dotnet_style_require_accessibility_modifiers = for_non_interface_members:warning
csharp_preferred_modifier_order = public,private,protected,internal,file,static,extern,new,virtual,abstract,sealed,override,readonly,unsafe,required,volatile,async:suggestion
csharp_prefer_static_local_function = true:suggestion

#### Naming ####

dotnet_naming_style.pascal_case.capitalization = pascal_case
dotnet_naming_style.camel_case.capitalization = camel_case

dotnet_naming_style.underscore_camel_case.capitalization = camel_case
dotnet_naming_style.underscore_camel_case.required_prefix = _

dotnet_naming_style.i_prefixed_pascal_case.capitalization = pascal_case
dotnet_naming_style.i_prefixed_pascal_case.required_prefix = I

# Interfaces: IThing
dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_symbols.interfaces.applicable_accessibilities = *
dotnet_naming_rule.interfaces_are_i_prefixed.symbols = interfaces
dotnet_naming_rule.interfaces_are_i_prefixed.style = i_prefixed_pascal_case
dotnet_naming_rule.interfaces_are_i_prefixed.severity = warning

# Private instance fields: _thing
dotnet_naming_symbols.private_instance_fields.applicable_kinds = field
dotnet_naming_symbols.private_instance_fields.applicable_accessibilities = private
dotnet_naming_rule.private_instance_fields_are_underscore_camel.symbols = private_instance_fields
dotnet_naming_rule.private_instance_fields_are_underscore_camel.style = underscore_camel_case
dotnet_naming_rule.private_instance_fields_are_underscore_camel.severity = warning

# Private static readonly fields read as constants in this codebase (GameProcessNames,
# ConnectorVersion, Columns), so they stay PascalCase and must win over the _field rule above.
dotnet_naming_symbols.private_static_readonly_fields.applicable_kinds = field
dotnet_naming_symbols.private_static_readonly_fields.applicable_accessibilities = private
dotnet_naming_symbols.private_static_readonly_fields.required_modifiers = static,readonly
dotnet_naming_rule.private_static_readonly_are_pascal.symbols = private_static_readonly_fields
dotnet_naming_rule.private_static_readonly_are_pascal.style = pascal_case
dotnet_naming_rule.private_static_readonly_are_pascal.severity = warning

# Constants: PascalCase
dotnet_naming_symbols.constants.applicable_kinds = field, local
dotnet_naming_symbols.constants.applicable_accessibilities = *
dotnet_naming_symbols.constants.required_modifiers = const
dotnet_naming_rule.constants_are_pascal.symbols = constants
dotnet_naming_rule.constants_are_pascal.style = pascal_case
dotnet_naming_rule.constants_are_pascal.severity = warning

# Everything public: PascalCase
dotnet_naming_symbols.public_members.applicable_kinds = property, method, field, event, delegate
dotnet_naming_symbols.public_members.applicable_accessibilities = public, internal, protected
dotnet_naming_rule.public_members_are_pascal.symbols = public_members
dotnet_naming_rule.public_members_are_pascal.style = pascal_case
dotnet_naming_rule.public_members_are_pascal.severity = warning

# Parameters and locals: camelCase
dotnet_naming_symbols.parameters_and_locals.applicable_kinds = parameter, local
dotnet_naming_rule.parameters_and_locals_are_camel.symbols = parameters_and_locals
dotnet_naming_rule.parameters_and_locals_are_camel.style = camel_case
dotnet_naming_rule.parameters_and_locals_are_camel.severity = suggestion

#### Interop ####

# R3E* shared-memory structs mirror the RaceRoom C header field-for-field. Their names and
# layout are dictated by that ABI, so naming and style rules must not push them around.
[src/RaceIntelligence.Connectors.RaceRoom/Interop/*.cs]
dotnet_diagnostic.IDE1006.severity = none

#### Tests ####

# Test methods use Long_snake_case_sentences to describe behaviour.
[tests/**/*.cs]
dotnet_diagnostic.IDE1006.severity = none
