<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\RaceIntelligence.Live.Contracts\RaceIntelligence.Live.Contracts.csproj" />
    <ProjectReference Include="..\RaceIntelligence.ServiceDefaults\RaceIntelligence.ServiceDefaults.csproj" />
  </ItemGroup>

  <!-- Microsoft.Extensions.Options.DataAnnotations is part of the shared framework the Web SDK
       targets, so ValidateDataAnnotations() needs no package reference here. -->
  <ItemGroup>
    <PackageReference Include="Serilog.AspNetCore" />
  </ItemGroup>

  <!-- The dashboard's sources are not compiled by MSBuild and must not be watched by it: without
       this, editing a .tsx file triggers a rebuild of the whole host, and node_modules alone is
       tens of thousands of files for the globber to walk on every build. -->
  <ItemGroup>
    <Content Remove="ClientApp\**" />
    <None Remove="ClientApp\node_modules\**" />
  </ItemGroup>

  <!-- wwwroot is generated, so it is taken out of the SDK's default content glob and added back
       explicitly by the publish target below. Leaving it in the glob would publish whatever a
       developer's last local `npm run build` happened to leave there — and worse, would collide
       with the files the target produces, since MSBuild evaluates items before any target runs
       and would then see each file twice. -->
  <ItemGroup>
    <Content Remove="wwwroot\**" />
  </ItemGroup>

  <PropertyGroup>
    <ClientAppDirectory>$(MSBuildProjectDirectory)\ClientApp</ClientAppDirectory>
    <!-- Set this to skip the frontend build — for a machine with no Node, or a backend-only
         container image that is served its wwwroot from elsewhere. -->
    <SkipClientAppBuild Condition="'$(SkipClientAppBuild)' == ''">false</SkipClientAppBuild>
  </PropertyGroup>

  <!--
    Builds the dashboard into wwwroot on publish, and only on publish.

    Deliberately not on every Build. A `dotnet build` runs constantly — every test run, every
    watch reload — and an npm build attached to it would add seconds to each one for output the
    backend tests never look at. Development runs the Vite dev server instead, which is faster and
    gives hot reload; `dotnet publish` is the one moment the bundle genuinely has to exist.

    `npm ci` rather than `npm install`: it installs exactly what package-lock.json pins and fails
    if the lock file disagrees with package.json, which is what makes a published bundle
    reproducible instead of whatever the registry served that morning.
  -->
  <Target Name="BuildClientApp"
          Condition="'$(SkipClientAppBuild)' != 'true' AND Exists('$(ClientAppDirectory)\package.json')">
    <Message Importance="high" Text="Building the dashboard (npm ci &amp;&amp; npm run build)..." />
    <Exec Command="npm ci" WorkingDirectory="$(ClientAppDirectory)" />
    <Exec Command="npm run build" WorkingDirectory="$(ClientAppDirectory)" />
  </Target>

  <!--
    Adds the freshly built bundle to the publish output.

    Separate from the build step and hooked here specifically because MSBuild evaluates item groups
    once, before any target runs: files that did not exist at evaluation are invisible to the
    default globs no matter when they appear. ComputeResolvedFilesToPublishList is the last point
    at which the publish set can still be added to.
  -->
  <Target Name="PublishClientApp"
          DependsOnTargets="BuildClientApp"
          BeforeTargets="ComputeResolvedFilesToPublishList"
          Condition="'$(SkipClientAppBuild)' != 'true'">
    <ItemGroup>
      <_ClientAppOutput Include="$(MSBuildProjectDirectory)\wwwroot\**\*" />
      <ResolvedFileToPublish Include="@(_ClientAppOutput)">
        <RelativePath>wwwroot\%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>

    <Warning Condition="'@(_ClientAppOutput)' == ''"
             Text="No dashboard bundle was produced in wwwroot; the published hub will serve the live API but no UI." />
  </Target>

</Project>
