<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- xUnit1051: these integration tests already bound their lifetime via the fixture and
         explicit timeouts; threading TestContext.Current.CancellationToken through every HTTP
         call adds noise without changing behaviour. Same rationale as the other test projects. -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.Testing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\RaceIntelligence.Ingest.Api\RaceIntelligence.Ingest.Api.csproj" />
    <ProjectReference Include="..\..\src\RaceIntelligence.AppHost\RaceIntelligence.AppHost.csproj" />
  </ItemGroup>

</Project>
