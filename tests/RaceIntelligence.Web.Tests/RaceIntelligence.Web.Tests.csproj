<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\..\src\RaceIntelligence.Web\RaceIntelligence.Web.csproj" />
  </ItemGroup>

  <!-- The end-to-end tests start a real Kestrel host, so they need the ASP.NET Core framework.
       A FrameworkReference rather than the Web SDK: the SDK would also scaffold a
       Properties/launchSettings.json with machine-specific ports, which is generated noise for a
       project nobody launches. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
  </ItemGroup>

</Project>
