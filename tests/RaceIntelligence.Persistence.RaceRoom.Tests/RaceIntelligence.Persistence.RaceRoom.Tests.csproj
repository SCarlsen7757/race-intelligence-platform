<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- xUnit1051 wants every async call to thread TestContext.Current.CancellationToken through
         for faster test-cancellation responsiveness. Not worth the churn across the many EF Core
         calls in this integration suite, where the container/query calls are already bounded. -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Testcontainers.PostgreSql" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\RaceIntelligence.Persistence.RaceRoom\RaceIntelligence.Persistence.RaceRoom.csproj" />
  </ItemGroup>

</Project>
