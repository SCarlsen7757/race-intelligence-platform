# Copy to `.env` next to compose.test.yml and fill in. `.env` is gitignored; this template is not.
#
#   cp .env.example .env
#
# Every value below is required — compose.test.yml uses the ${VAR:?message} form so a missing one
# stops the deploy with a named error rather than starting a service that half works.

# --- Database ---------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# --- Shared secrets ---------------------------------------------------------------------------
# One key per service, plus one per collector, on purpose: they guard things with different
# exposure, and one key for all of them would mean a leak of any compromises the rest. Generate
# each separately, e.g. `openssl rand -base64 32`.

# This machine's collector presents this to the ingest API. The API holds a set of these keyed by
# a label (see compose.test.yml), so a second driver gets their own key rather than sharing this
# one — revoking one collector then leaves the other working.
#
# Now that the ingest API is on the tunnel this key travels the internet, so it is worth generating
# properly rather than typing something memorable.
INGEST_API_KEY=

# The collector presents this to the live hub's publish socket. Same standard as the ingest key
# above: both services are reachable from the internet.
LIVE_API_KEY=

# --- Public origins ---------------------------------------------------------------------------
# All three are addresses a browser will use, including the scheme, and with no trailing slash.
# The ingest API has a fourth public hostname, but no browser uses it and nothing in compose reads
# it — a collector is configured with it directly, so it lives in docs/deployment.md, not here.

# Where viewers load the dashboard. Becomes the hub's Live:AllowedOrigins entry, so it is compared
# against the Origin header browsers send.
DASHBOARD_ORIGIN=https://race-web.example.com

# Where the browser opens its WebSocket — the HUB's public hostname, not the dashboard's.
#
# BAKED INTO THE DASHBOARD IMAGE AT BUILD TIME. Changing it requires
# `docker compose -f compose.test.yml build dashboard`, not a restart. It must be https:// — the
# socket scheme is derived from this value, so an http:// origin yields a ws:// URL that browsers
# block as mixed content.
HUB_ORIGIN=https://race-api.example.com

# Where the browser fetches stored sessions — the READ API's public hostname, a third origin.
#
# ALSO BAKED INTO THE DASHBOARD IMAGE AT BUILD TIME, with the same consequence: changing it is a
# rebuild, not a restart. Unlike HUB_ORIGIN there is no mixed-content trap here — this is a plain
# fetch, not a socket — but it should still be https for the same reason the page is.
#
# DASHBOARD_ORIGIN above becomes this service's Read:AllowedOrigins entry as well as the hub's.
READ_ORIGIN=https://race-read.example.com

# --- Tunnel -----------------------------------------------------------------------------------
# From the Cloudflare Zero Trust dashboard. Its ingress rules must route:
#   race-web.example.com  -> http://dashboard:3000
#   race-api.example.com  -> http://web:8080
#   race-read.example.com -> http://read-api:8080
#   race-ingest.example.com -> http://ingest-api:8080
# The ingest API is published so a collector on another network can upload. Its guard is one
# constant-time-compared key per collector plus a rate limiter; it has no origin allowlist, because
# its client is a console app rather than a browser. The read API is safe to publish for a
# different reason: it holds no key, writes nothing, and only serves GETs.
CLOUDFLARE_TUNNEL_TOKEN=
