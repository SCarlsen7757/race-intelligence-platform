#!/bin/sh
#
# Keeps the graphify knowledge graph current after every commit.
#
# This hook is tracked in the repository and is used because Directory.Build.props points
# core.hooksPath here on build. Hooks in .git/hooks are deliberately NOT used: that directory is
# not version-controlled, so a hook living there drifts per machine and is invisible in review.
# Edit this file instead; the change reaches everyone through the normal commit/PR flow.
#
# The work runs detached because a full update takes several seconds and a commit should not wait
# for it. Output goes to the log named below. Nothing here can fail a commit: every branch exits 0.
#
# Set GRAPHIFY_SKIP_HOOK=1 to skip (e.g. for scripted bulk commits).

set -u

[ "${GRAPHIFY_SKIP_HOOK:-0}" = "1" ] && exit 0

# An in-progress rebase, merge or cherry-pick fires post-commit repeatedly; rebuilding on each
# intermediate commit is wasted work, and the final commit triggers a rebuild anyway.
GIT_DIR_PATH=$(git rev-parse --git-dir 2>/dev/null) || exit 0
[ -d "$GIT_DIR_PATH/rebase-merge" ] && exit 0
[ -d "$GIT_DIR_PATH/rebase-apply" ] && exit 0
[ -f "$GIT_DIR_PATH/MERGE_HEAD" ] && exit 0
[ -f "$GIT_DIR_PATH/CHERRY_PICK_HEAD" ] && exit 0

REPO=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
SCRIPT="$REPO/tools/update-graph.py"
[ -f "$SCRIPT" ] || exit 0

# Nothing to do when the commit touched no indexed source.
CHANGED=$(git diff-tree --no-commit-id --name-only -r HEAD 2>/dev/null | grep -v '^graphify-out/')
[ -z "$CHANGED" ] && exit 0

# Prefer the interpreter graphify itself recorded, so the hook uses the environment that actually
# has graphify installed rather than whatever `python` happens to resolve to first.
PY=""
PY_FILE="$REPO/graphify-out/.graphify_python"
if [ -f "$PY_FILE" ]; then
    CANDIDATE=$(tr -d '\r\n' < "$PY_FILE")
    [ -n "$CANDIDATE" ] && [ -x "$CANDIDATE" ] && PY="$CANDIDATE"
fi
[ -z "$PY" ] && PY=$(command -v python3 2>/dev/null)
[ -z "$PY" ] && PY=$(command -v python 2>/dev/null)
if [ -z "$PY" ]; then
    echo "[graph hook] no python found; skipping graph update" >&2
    exit 0
fi

LOG="$REPO/graphify-out/hook.log"
mkdir -p "$REPO/graphify-out" 2>/dev/null

echo "[graph hook] updating knowledge graph in background (log: graphify-out/hook.log)"
"$PY" "$SCRIPT" >"$LOG" 2>&1 &

exit 0
